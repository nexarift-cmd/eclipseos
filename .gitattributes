# Keep text files LF so live-build, shell scripts and theme files behave
# identically when the repository is checked out on Windows and Linux.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.iso binary
*.qcow2 binary
*.vdi binary
*.vmdk binary
*.ova binary
*.gz binary
*.xz binary
*.zst binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
