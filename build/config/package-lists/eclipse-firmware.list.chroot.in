# EclipseOS redistributable firmware list (non-free-firmware).
#
# This is the documented exception to the open-source-only policy: vendor
# firmware blobs that Debian redistributes, needed for Wi-Fi, graphics, audio
# and common wired network hardware. Nothing here is a driver; no proprietary
# driver is installed. See docs/licenses.md for the full exception list.
#
# This template is copied to eclipse-firmware.list.chroot by scripts/build.sh
# unless the image is built with STRICT_FOSS=1, in which case the list is not
# generated at all and the ISO contains no non-free-firmware packages.
#
# Deliberately NOT included (and why):
#   firmware-nvidia-graphics   NVIDIA firmware only ships as an explicit
#                              installer opt-in, never preinstalled
#   firmware-ivtv              asks the user to accept a licence at install
#   firmware-ipw2x00           asks the user to accept a licence at install
#   firmware-sof-signed        audio DSP firmware outside the approved scope
#   intel-microcode/amd64-microcode
#                              CPU microcode is a Phase 6 hardware-hardening
#                              decision, not part of the Phase 1 scope

firmware-amd-graphics
firmware-atheros
firmware-bnx2
firmware-bnx2x
firmware-brcm80211
firmware-cavium
firmware-intel-graphics
firmware-intel-misc
firmware-intel-sound
firmware-iwlwifi
firmware-libertas
firmware-marvell-prestera
firmware-mediatek
firmware-misc-nonfree
firmware-myricom
firmware-netronome
firmware-netxen
firmware-qcom-soc
firmware-qlogic
firmware-realtek
firmware-samsung
firmware-siano
firmware-ti-connectivity
firmware-zd1211
