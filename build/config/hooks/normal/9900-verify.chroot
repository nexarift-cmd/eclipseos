#!/bin/sh
#
# EclipseOS 9900-verify: last-resort checks before the root filesystem is
# packed. Runs after every stock live-build hook, so it sees the tree that
# will be squashed into the ISO.
#
# These checks exist so that a missing asset, a reverted account policy or an
# unexpected package fails the build instead of producing an ISO that boots
# into something else. They are cheap; keep them strict.
set -eu
export LC_ALL=C

fail() {
    printf '9900-verify: %s\n' "$*" >&2
    exit 1
}

# ---------------------------------------------------------------------------
# Required files
# ---------------------------------------------------------------------------
for file in \
    /etc/hostname \
    /etc/hosts \
    /etc/resolv.conf \
    /etc/os-release \
    /etc/issue \
    /etc/motd \
    /etc/sudoers.d/90-eclipseos-live \
    /etc/sddm.conf.d/50-eclipseos.conf \
    /etc/xdg/kdeglobals \
    /etc/xdg/kscreenlockerrc \
    /etc/xdg/kwalletrc \
    /etc/xdg/autostart/org.eclipseos.welcome.desktop \
    /etc/plymouth/plymouthd.conf \
    /usr/local/bin/eclipseos-plasma-session \
    /usr/local/bin/eclipseos-welcome \
    /usr/libexec/eclipseos/eclipseos-session-select \
    /usr/libexec/eclipseos/eclipseos-theme-boot \
    /usr/libexec/eclipseos/eclipseos-bootcheck \
    /usr/lib/systemd/system/eclipseos-bootcheck.service \
    /usr/lib/systemd/system/eclipseos-session.service \
    /usr/lib/systemd/system/eclipseos-theme.service \
    /usr/share/wayland-sessions/eclipseos-wayland.desktop \
    /usr/share/xsessions/eclipseos-x11.desktop \
    /usr/share/plasma/look-and-feel/org.eclipseos.desktop/metadata.json \
    /usr/share/plasma/look-and-feel/org.eclipseos.desktop/contents/defaults \
    /usr/share/plasma/look-and-feel/org.eclipseos.desktop/contents/layouts/org.kde.plasma.desktop-layout.js \
    /usr/share/plasma/look-and-feel/org.eclipseos.desktop/contents/plasmoidsetupscripts/org.kde.plasma.icontasks.js \
    /usr/share/plasma/look-and-feel/org.eclipseos.desktop/contents/plasmoidsetupscripts/org.kde.plasma.kickoff.js \
    /usr/share/plasma/look-and-feel/org.eclipseos.desktop/contents/splash/Splash.qml \
    /usr/share/color-schemes/EclipseOS.colors \
    /usr/share/color-schemes/EclipseOSLight.colors \
    /usr/share/icons/hicolor/scalable/apps/eclipseos.svg \
    /usr/share/backgrounds/eclipseos/eclipseos-wallpaper-1920x1080.png \
    /usr/share/pixmaps/eclipseos/eclipseos-mark-256.png \
    /usr/share/plymouth/themes/eclipseos/eclipseos.plymouth \
    /usr/share/plymouth/themes/eclipseos/eclipseos.script \
    /usr/share/plymouth/themes/eclipseos/splash.png \
    /usr/share/plymouth/themes/eclipseos/logo.png \
    /usr/share/plymouth/themes/eclipseos/eclipseos-progress-track.png \
    /usr/share/plymouth/themes/eclipseos/eclipseos-progress-fill.png \
    /usr/share/doc/eclipseos/copyright \
    /usr/share/doc/eclipseos/licenses.md \
    /usr/share/doc/eclipseos/packages.tsv \
    /usr/share/doc/eclipseos/non-free-firmware.tsv \
    ; do
    [ -s "$file" ] || fail "missing or empty: $file"
done

for file in \
    /usr/local/bin/eclipseos-plasma-session \
    /usr/local/bin/eclipseos-welcome \
    /usr/libexec/eclipseos/eclipseos-session-select \
    /usr/libexec/eclipseos/eclipseos-theme-boot \
    /usr/libexec/eclipseos/eclipseos-bootcheck \
    ; do
    [ -x "$file" ] || fail "not executable: $file"
done

# ---------------------------------------------------------------------------
# Identity and live account
# ---------------------------------------------------------------------------
[ "$(cat /etc/hostname)" = "eclipseos" ] \
    || fail "/etc/hostname is not 'eclipseos': $(cat /etc/hostname)"

grep -qx 'ID=eclipseos' /etc/os-release \
    || fail '/etc/os-release does not identify the system as eclipseos'

grep -qw 'eclipseos' /etc/hosts \
    || fail '/etc/hosts does not map the eclipseos hostname'

id eclipse >/dev/null 2>&1 || fail 'live user eclipse does not exist'

# Second field of `passwd -S` is NP for an account without a password.
passwd -S eclipse 2>/dev/null | awk '{ exit ($2 == "NP") ? 0 : 1 }' \
    || fail 'live user eclipse has a password set'

grep -q '^eclipse ALL=' /etc/sudoers.d/90-eclipseos-live \
    || fail 'the live sudo drop-in does not grant the eclipse user sudo'

# The whole design depends on live-config not being present: it would rewrite
# the hostname, users and services at boot.
if dpkg-query -W -f='${db:Status-Abbrev}' live-config 2>/dev/null | grep -q '^ii'; then
    fail 'live-config is installed; the live session would be reconfigured at boot'
fi

# The live image must not inherit the build host's resolver configuration.
grep -q 'NetworkManager replaces' /etc/resolv.conf \
    || fail '/etc/resolv.conf is not the EclipseOS fallback file'

# ---------------------------------------------------------------------------
# Boot units
# ---------------------------------------------------------------------------
for unit in sddm.service NetworkManager.service eclipseos-session.service eclipseos-theme.service eclipseos-bootcheck.service; do
    [ "$(systemctl is-enabled "$unit" 2>/dev/null || true)" = "enabled" ] \
        || fail "$unit is not enabled"
done

[ "$(systemctl get-default)" = "graphical.target" ] \
    || fail 'the default systemd target is not graphical.target'

grep -qx 'Theme=eclipseos' /etc/plymouth/plymouthd.conf \
    || fail 'plymouth is not configured to use the EclipseOS theme'

# ---------------------------------------------------------------------------
# Plasma session
# ---------------------------------------------------------------------------
for package in plasma-desktop plasma-workspace sddm kwin-x11; do
    if ! dpkg-query -W -f='${db:Status-Abbrev}' "$package" 2>/dev/null | grep -q '^ii'; then
        fail "$package is not installed; the Phase 2 desktop is incomplete"
    fi
done

if dpkg-query -W -f='${db:Status-Abbrev}' lightdm 2>/dev/null | grep -q '^ii'; then
    fail 'lightdm is still installed; SDDM must be the only display manager'
fi
if dpkg-query -W -f='${db:Status-Abbrev}' openbox 2>/dev/null | grep -q '^ii'; then
    fail 'openbox is still installed; Plasma must own the session'
fi

grep -qx 'User=eclipse' /etc/sddm.conf.d/50-eclipseos.conf \
    || fail 'SDDM is not configured to autologin the live user'
grep -qx 'Session=eclipseos-x11' /etc/sddm.conf.d/50-eclipseos.conf \
    || fail 'SDDM does not retain the safe X11 fallback session'
grep -q 'systemd-detect-virt --vm --quiet' /usr/libexec/eclipseos/eclipseos-session-select \
    || fail 'the VM session selector does not use systemd-detect-virt'
grep -q 'Session=$session' /usr/libexec/eclipseos/eclipseos-session-select \
    || fail 'the VM session selector does not write the selected SDDM session'

grep -q '^Exec=/usr/local/bin/eclipseos-plasma-session$' /usr/share/wayland-sessions/eclipseos-wayland.desktop \
    || fail 'the Wayland session does not launch the EclipseOS session wrapper'
grep -q '^Exec=/usr/bin/startplasma-x11$' /usr/share/xsessions/eclipseos-x11.desktop \
    || fail 'the X11 fallback session does not launch Plasma'

grep -qx 'LookAndFeelPackage=org.eclipseos.desktop' /etc/xdg/kdeglobals \
    || fail 'the EclipseOS Plasma look and feel is not the system default'
grep -qx 'ColorScheme=EclipseOS' /etc/xdg/kdeglobals \
    || fail 'the EclipseOS colour scheme is not the system default'
grep -qx 'LookAndFeelPackage=org.eclipseos.desktop' /home/eclipse/.config/kdeglobals \
    || fail 'the live user profile does not default to the EclipseOS look and feel'

printf '9900-verify: all Phase 2 checks passed\n'
