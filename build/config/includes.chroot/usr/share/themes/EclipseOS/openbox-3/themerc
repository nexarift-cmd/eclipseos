# EclipseOS openbox theme (original artwork, GPL-3.0-or-later).
# Colours come from branding/tokens.json; Phase 2 replaces openbox.

border.width: 1
padding.width: 4
padding.height: 4
window.client.padding.width: 0
window.client.padding.height: 0
window.handle.width: 0

window.active.title.bg: flat solid
window.active.title.bg.color: #141020
window.active.label.text.color: #F5F1FA
window.active.border.color: #6C4DFF
window.active.button.unpressed.image.color: #C9C1D8
window.active.button.hover.image.color: #FFD166
window.active.button.pressed.image.color: #FFB347
window.active.button.disabled.image.color: #5E5569

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #0B0714
window.inactive.label.text.color: #A78BFA
window.inactive.border.color: #241C35
window.inactive.button.unpressed.image.color: #5E5569

window.label.text.justify: center

menu.items.bg: flat solid
menu.items.bg.color: #141020
menu.items.text.color: #F5F1FA
menu.items.disabled.text.color: #5E5569
menu.items.active.bg: flat solid
menu.items.active.bg.color: #6C4DFF
menu.items.active.text.color: #FFFFFF

menu.title.bg: flat solid
menu.title.bg.color: #0B0714
menu.title.text.color: #FFD166
menu.title.text.justify: center

menu.separator.color: #4A2ED1
menu.separator.width: 1
