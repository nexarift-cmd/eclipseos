# EclipseOS Plymouth theme (original artwork, GPL-3.0-or-later).
#
# Text-free on purpose: the logo and the progress bar are images, so the theme
# renders identically without any font package and cannot show stale boot
# messages over the brand artwork.
#
# Assets are generated by branding/render.py at build time:
#   splash.png                 - 1920x1080 background gradient
#   logo.png                   - transparent EclipseOS mark
#   eclipseos-progress-track.png - 360x4 solid track
#   eclipseos-progress-fill.png  - 360x4 solid fill
#
# The Plymouth script API (24.004.60) has Sprites and Images but no drawing
# primitives, so the bar is a scaled fill image over a static track image.

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
screen_x = Window.GetX();
screen_y = Window.GetY();

background_image = Image("splash.png");
background_image = background_image.Scale(screen_width, screen_height);
background_sprite = Sprite(background_image);
background_sprite.SetPosition(screen_x, screen_y, -1000);

logo_image = Image("logo.png");
logo_width = Math.Int(screen_width * 0.16);
if (logo_width < 1)
  {
    logo_width = 1;
  }
logo_height = Math.Int(logo_image.GetHeight() * logo_width / logo_image.GetWidth());
if (logo_height < 1)
  {
    logo_height = 1;
  }
logo_image = logo_image.Scale(logo_width, logo_height);
logo_sprite = Sprite(logo_image);
logo_sprite.SetPosition(
    screen_x + Math.Int((screen_width - logo_width) / 2),
    screen_y + Math.Int(screen_height * 0.32),
    10
);

bar_width = Math.Int(screen_width * 0.18);
if (bar_width < 36)
  {
    bar_width = 36;
  }
bar_height = 4;
bar_x = screen_x + Math.Int((screen_width - bar_width) / 2);
bar_y = screen_y + Math.Int(screen_height * 0.70);

track_image = Image("eclipseos-progress-track.png");
track_image = track_image.Scale(bar_width, bar_height);
track_sprite = Sprite(track_image);
track_sprite.SetPosition(bar_x, bar_y, 0);

fill_source = Image("eclipseos-progress-fill.png");
fill_sprite = Sprite(fill_source.Scale(1, bar_height));
fill_sprite.SetPosition(bar_x, bar_y, 1);

fun boot_progress(duration, progress)
{
    if (progress < 0)
      {
        progress = 0;
      }
    if (progress > 1)
      {
        progress = 1;
      }
    fill_width = Math.Int(bar_width * progress);
    if (fill_width < 1)
      {
        fill_width = 1;
      }
    fill_sprite.SetImage(fill_source.Scale(fill_width, bar_height));
}

Plymouth.SetBootProgressFunction(boot_progress);
