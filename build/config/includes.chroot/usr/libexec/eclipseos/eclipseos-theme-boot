#!/bin/sh
#
# Select the EclipseOS live colour scheme before SDDM starts.
#
# A normal boot uses the saved live-user choice, or EclipseOS dark when no
# choice exists. The kernel command line can override it for one boot with
# eclipseos.theme=light or eclipseos.theme=dark; that override is deliberately
# not persisted, so the next boot returns to the user's saved choice.
#
# The user can switch at runtime with eclipseos-theme (also in the Start
# menu). This service runs before Plasma, so it updates kdeglobals directly
# rather than using plasma-apply-colorscheme, which needs a session bus.
set -eu

theme=""
# The kernel command line is whitespace-separated; word splitting is intended.
# shellcheck disable=SC2013
for argument in $(cat /proc/cmdline); do
    case "$argument" in
        eclipseos.theme=light) theme=light ;;
        eclipseos.theme=dark) theme=dark ;;
    esac
done

state=/home/eclipse/.config/eclipseos/theme
if [ -z "$theme" ] && [ -r "$state" ]; then
    saved="$(cat "$state" 2>/dev/null || true)"
    case "$saved" in
        light|dark) theme="$saved" ;;
    esac
fi
theme="${theme:-dark}"

printf '%s\n' "$theme" > /run/eclipseos-theme

config=/home/eclipse/.config/kdeglobals
[ -f "$config" ] || exit 0

if [ "$theme" = "light" ]; then
    scheme=EclipseOSLight
    plasma_theme=breeze-light
else
    scheme=EclipseOS
    plasma_theme=default
fi

sed -i "s/^ColorScheme=.*/ColorScheme=$scheme/" "$config"
grep -qx "ColorScheme=$scheme" "$config" \
    || { printf 'eclipseos-theme: could not select the %s colour scheme\n' "$theme" >&2; exit 1; }
chown eclipse:eclipse "$config"

# The colour scheme controls applications, but the Plasma shell, panel and
# window decoration use a Plasma desktop theme as well. Select the matching
# Breeze light/dark variant before Plasma starts; eclipseos-theme applies the
# same pair again inside the live session, after the session bus is available.
plasmarc=/home/eclipse/.config/plasmarc
if [ -f "$plasmarc" ]; then
    sed -i "s/^name=.*/name=$plasma_theme/" "$plasmarc"
else
    printf '[Theme]\nname=%s\n' "$plasma_theme" > "$plasmarc"
fi
grep -qx "name=$plasma_theme" "$plasmarc" \
    || { printf 'eclipseos-theme: could not select the %s Plasma theme\n' "$theme" >&2; exit 1; }
chown eclipse:eclipse "$plasmarc"
