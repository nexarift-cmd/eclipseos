[Unit]
Description=EclipseOS live boot verification
After=display-manager.service
Wants=display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/eclipseos/eclipseos-bootcheck
RemainAfterExit=yes
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
