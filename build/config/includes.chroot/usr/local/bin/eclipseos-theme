#!/bin/sh
#
# Switch the EclipseOS light/dark colour scheme.
#
# Usage: eclipseos-theme [light|dark|toggle|status|apply]
#
# `apply` re-applies the saved scheme at login without changing it. The
# command can be launched from the Start menu or a terminal; it runs as the
# live user and stores the choice in ~/.config/eclipseos/theme so the next
# login keeps it. A kernel command line value is still handled by
# eclipseos-theme-boot before SDDM starts.
set -eu

if [ "$(id -u)" -eq 0 ]; then
    # Never write root-owned files into the live user's profile.
    if id eclipse >/dev/null 2>&1; then
        if command -v runuser >/dev/null 2>&1; then
            exec runuser -u eclipse -- "$0" "$@"
        fi
        exec su -s /bin/sh eclipse -c "'$0' $*"
    fi
    exec "$0" "$@"
fi

action="${1:-toggle}"
config="${XDG_CONFIG_HOME:-$HOME/.config}/kdeglobals"
plasmarc="${XDG_CONFIG_HOME:-$HOME/.config}/plasmarc"
state_dir="${XDG_CONFIG_HOME:-$HOME/.config}/eclipseos"
state_file="$state_dir/theme"
light_scheme="EclipseOSLight"
dark_scheme="EclipseOS"
light_lookandfeel="org.eclipseos.light.desktop"
dark_lookandfeel="org.eclipseos.desktop"
plasma_theme="default"
theme_state_dir="${XDG_CACHE_HOME:-$HOME/.cache}/eclipseos-theme"
theme_status_file="$theme_state_dir/last"
theme_debug_file="$theme_state_dir/debug.log"
mkdir -p "$theme_state_dir" 2>/dev/null || true

write_theme_status() {
    {
        printf 'applied=%s\n' "$1"
        printf 'theme=%s\n' "$theme"
        printf 'scheme=%s\n' "$scheme"
        printf 'lookandfeel=%s\n' "$lookandfeel"
        printf 'updated=%s\n' "$(date +%s)"
    } >"$theme_status_file"
}

current_scheme() {
    if [ -r "$config" ]; then
        sed -n 's/^ColorScheme=//p' "$config" | head -n 1
    fi
}

persist=1
case "$action" in
    light) theme="light" ;;
    dark) theme="dark" ;;
    toggle)
        if [ "$(current_scheme)" = "$light_scheme" ]; then
            theme="dark"
        else
            theme="light"
        fi
        ;;
    apply)
        persist=0
        if [ "$(current_scheme)" = "$light_scheme" ]; then
            theme="light"
        elif [ -r "$state_file" ]; then
            theme="$(cat "$state_file")"
        else
            theme="dark"
        fi
        ;;
    status)
        current="$(current_scheme)"
        if [ "$current" = "$light_scheme" ]; then
            printf 'light\n'
        elif [ -n "$current" ]; then
            printf 'dark\n'
        else
            printf 'unknown\n'
        fi
        exit 0
        ;;
    *)
        printf 'Usage: %s [light|dark|toggle|status|apply]\n' "$0" >&2
        exit 2
        ;;
esac

if [ "$theme" = "light" ]; then
    scheme="$light_scheme"
    lookandfeel="$light_lookandfeel"
    wallpaper="/usr/share/backgrounds/eclipseos/eclipseos-wallpaper-light-1920x1080.png"
else
    scheme="$dark_scheme"
    lookandfeel="$dark_lookandfeel"
    wallpaper="/usr/share/backgrounds/eclipseos/eclipseos-wallpaper-1920x1080.png"
fi

if [ "$persist" -eq 1 ]; then
    mkdir -p "$state_dir"
    printf '%s\n' "$theme" > "$state_file"
    chmod 0644 "$state_file"
fi

# Apply the global theme, then re-assert the three visible Plasma layers:
# colour scheme, widget/desktop theme and wallpaper. Applying the global theme
# switches the shell's defaults (including the EclipseOS wallpaper); the
# individual commands keep the result deterministic if the theme package is
# applied while the panel is still starting.
apply_session() {
    printf 'apply theme=%s lookandfeel=%s dbus=%s\n' \
        "$theme" "$lookandfeel" "${DBUS_SESSION_BUS_ADDRESS:+yes}" \
        >>"$theme_debug_file" 2>/dev/null || true
    [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || return 1
    command -v plasma-apply-lookandfeel >/dev/null 2>&1 || return 1
    command -v plasma-apply-colorscheme >/dev/null 2>&1 || return 1
    command -v plasma-apply-desktoptheme >/dev/null 2>&1 || return 1
    command -v plasma-apply-wallpaperimage >/dev/null 2>&1 || return 1

    if plasma-apply-lookandfeel --apply "$lookandfeel" >/dev/null 2>&1; then lf_rc=0; else lf_rc=1; fi
    if plasma-apply-colorscheme "$scheme" >/dev/null 2>&1; then scheme_rc=0; else scheme_rc=1; fi
    if plasma-apply-desktoptheme "$plasma_theme" >/dev/null 2>&1; then theme_rc=0; else theme_rc=1; fi
    if [ -f "$wallpaper" ]; then wallpaper_file_rc=0; else wallpaper_file_rc=1; fi
    if plasma-apply-wallpaperimage "$wallpaper" >/dev/null 2>&1; then wallpaper_rc=0; else wallpaper_rc=1; fi

    printf 'attempt lookandfeel=%s colours=%s desktoptheme=%s wallpaper_file=%s wallpaper=%s\n' \
        "$lf_rc" "$scheme_rc" "$theme_rc" "$wallpaper_file_rc" "$wallpaper_rc" \
        >>"$theme_debug_file" 2>/dev/null || true

    [ "$lf_rc" -eq 0 ] || return 1
    [ "$scheme_rc" -eq 0 ] || return 1
    [ "$theme_rc" -eq 0 ] || return 1
    [ "$wallpaper_file_rc" -eq 0 ] || return 1
    [ "$wallpaper_rc" -eq 0 ] || return 1
    return 0
}

applied=0
if [ "$action" = "apply" ]; then
    # XDG autostart runs this before Plasma has finished starting. Retry
    # briefly instead of silently leaving the previous session's theme in
    # place; the final screenshot/tests then observe the real rendered theme.
    attempt=0
    while [ "$attempt" -lt 20 ]; do
        if apply_session; then
            applied=1
            break
        fi
        attempt=$((attempt + 1))
        sleep 1
    done
else
    if apply_session; then
        applied=1
    fi
fi

# Direct KConfig writes are a fallback for a command-line invocation outside
# a Plasma session. They also make the next login deterministic if Plasma was
# not ready yet.
if [ "$applied" -eq 0 ]; then
    if command -v kwriteconfig6 >/dev/null 2>&1; then
        kwriteconfig6 --file "$config" --group KDE --key LookAndFeelPackage "$lookandfeel"
        kwriteconfig6 --file "$config" --group General --key ColorScheme "$scheme"
        kwriteconfig6 --file "$plasmarc" --group Theme --key name "$plasma_theme"
    else
        mkdir -p "$(dirname "$config")"
        if [ ! -f "$config" ]; then
            printf '[KDE]\nLookAndFeelPackage=%s\n\n[General]\nColorScheme=%s\n' \
                "$lookandfeel" "$scheme" > "$config"
        else
            if grep -q '^LookAndFeelPackage=' "$config"; then
                sed -i "s/^LookAndFeelPackage=.*/LookAndFeelPackage=$lookandfeel/" "$config"
            elif grep -q '^\[KDE\]' "$config"; then
                sed -i "/^\[KDE\]/a LookAndFeelPackage=$lookandfeel" "$config"
            else
                printf '\n[KDE]\nLookAndFeelPackage=%s\n' "$lookandfeel" >> "$config"
            fi
            if grep -q '^ColorScheme=' "$config"; then
                sed -i "s/^ColorScheme=.*/ColorScheme=$scheme/" "$config"
            elif grep -q '^\[General\]' "$config"; then
                sed -i "/^\[General\]/a ColorScheme=$scheme" "$config"
            else
                printf '\n[General]\nColorScheme=%s\n' "$scheme" >> "$config"
            fi
        fi

        mkdir -p "$(dirname "$plasmarc")"
        if [ -f "$plasmarc" ] && grep -q '^name=' "$plasmarc"; then
            sed -i "s/^name=.*/name=$plasma_theme/" "$plasmarc"
        else
            printf '\n[Theme]\nname=%s\n' "$plasma_theme" >> "$plasmarc"
        fi
    fi
fi

# Make the change visible to applications that cache KGlobalSettings values.
if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v qdbus6 >/dev/null 2>&1; then
    qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
fi

write_theme_status "$applied" 2>/dev/null || true

printf 'EclipseOS theme: %s\n' "$theme"

# The login autostart entry treats a fallback-only apply as a failure so its
# retry loop can try again once the session bus is available.
if [ "$action" = "apply" ] && [ "$applied" -eq 0 ]; then
    exit 1
fi
