#!/bin/sh
#
# EclipseOS Phase 1 X11 session.
#
# Deliberately small: openbox is the window manager, feh paints the wallpaper,
# and eclipseos-welcome opens a terminal with system facts. Phase 2 replaces
# this entry point with the Plasma session; nothing else in the image should
# depend on openbox.
#
# The environment is set explicitly instead of relying on the display manager
# so that the live session behaves the same in VirtualBox and on real hardware.
set -eu

export LANG=C.UTF-8
export XDG_SESSION_TYPE=x11
export XDG_SESSION_DESKTOP=eclipseos
export XDG_CURRENT_DESKTOP=EclipseOS
export XDG_CONFIG_DIRS=/etc/xdg

# openbox-session runs /etc/xdg/openbox/autostart and then execs openbox.
exec openbox-session
