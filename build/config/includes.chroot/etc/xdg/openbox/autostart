#!/bin/sh
#
# openbox system-wide autostart for the EclipseOS live session.
# Runs once per session, before openbox itself is exec'd.

# Wallpaper. If the generated asset is missing the session still comes up;
# the boot check would fail later, which is the correct outcome.
if [ -r /usr/share/backgrounds/eclipseos/eclipseos-wallpaper-1920x1080.png ]; then
    feh --no-fehbg --bg-fill \
        /usr/share/backgrounds/eclipseos/eclipseos-wallpaper-1920x1080.png \
        >/dev/null 2>&1 || true
fi

# Welcome window with system facts (live media only).
/usr/local/bin/eclipseos-welcome >/dev/null 2>&1 &
