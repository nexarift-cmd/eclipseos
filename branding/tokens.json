{
  "name": "EclipseOS",
  "version": "26.10",
  "brand": {
    "motif": "occluded sun with corona",
    "tagline": "Your desktop, in a new light."
  },
  "colors": {
    "void": "#0B0714",
    "night": "#141020",
    "surfaceDark": "#1B1528",
    "surfaceRaisedDark": "#241C35",
    "surfaceLight": "#F7F4FB",
    "surfaceRaisedLight": "#FFFFFF",
    "violet": "#6C4DFF",
    "violetDeep": "#4A2ED1",
    "violetSoft": "#A78BFA",
    "amber": "#FFB347",
    "corona": "#FFD166",
    "textPrimaryDark": "#F5F1FA",
    "textSecondaryDark": "#C9C1D8",
    "textPrimaryLight": "#18121F",
    "textSecondaryLight": "#5E5569",
    "success": "#36C98F",
    "warning": "#F2B84B",
    "danger": "#F05D6B"
  },
  "typography": {
    "family": "Inter",
    "fallbacks": ["Noto Sans", "DejaVu Sans", "sans-serif"],
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "baseSizePx": 15,
    "scale": [12, 13, 15, 17, 20, 24, 30, 36]
  },
  "geometry": {
    "radiusWindow": 8,
    "radiusPanel": 12,
    "radiusFloating": 16,
    "taskbarHeight": 48,
    "taskbarIcon": 24,
    "spacingUnit": 4,
    "borderWidth": 1
  },
  "motion": {
    "fastMs": 120,
    "normalMs": 180,
    "slowMs": 260,
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  },
  "accessibility": {
    "minimumContrast": 4.5,
    "respectReducedMotion": true,
    "focusRing": "#FFD166"
  }
}
